{
  "name": "front",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/moment-timezone": "^6.1.22",
    "@fullcalendar/react": "^6.1.17",
    "@fullcalendar/timegrid": "^6.1.22",
    "@linagora/twake-bar": "^1.1.2",
    "@linagora/twake-css": "^1.1.0",
    "@linagora/twake-icons": "^3.0.0",
    "@linagora/twake-mui": "^19.5.0",
    "@linagora/twake-oidc": "^1.3.0",
    "@linagora/twake-sdk": "^1.2.0",
    "@linagora/twake-utils": "1.2.1",
    "@linagora/twake-websocket": "^1.2.0",
    "@lottiefiles/dotlottie-react": "^0.21.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/react": "^11.10.0",
    "classnames": "^2.5.1",
    "cozy-intent": "^2.31.1",
    "cozy-interapp": "^0.22.2",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.13",
    "html-react-parser": "^6.1.9",
    "ical.js": "^2.2.0",
    "ky": "^2.2.0",
    "lodash": "^4.17.23",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48",
    "p-map": "^7.1.1",
    "react": "^18.2.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.6",
    "react-redux": "^9.3.1",
    "react-router": "^7.18.4",
    "react-virtuoso": "^4.18.20",
    "redux-first-history": "^5.2.0",
    "twake-i18n": "^0.7.1"
  },
  "workspaces": [
    "apps/*",
    "common"
  ],
  "scripts": {
    "start:private": "npm run start -w @calendar/private",
    "start:public": "npm run start -w @calendar/public",
    "build": "npm run build:private && npm run build:public",
    "build:private": "npm run build -w @calendar/private",
    "build:public": "npm run build -w @calendar/public",
    "serve:private": "npx serve -s apps/private/dist -l 5000",
    "serve:public": "npx serve -s apps/public/dist -l 5001",
    "test": "vitest run",
    "lint": "rs lint apps common",
    "lint:fix": "rs lint --fix apps common && rs fmt",
    "lint:fmt": "rs fmt --check",
    "fmt": "rs fmt",
    "copy-from-common": "node scripts/copy-from-common.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.0",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-stylus": "^2.0.1",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@sentry/webpack-plugin": "^5.4.0",
    "@tanstack/eslint-plugin-query": "^5.105.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "10.14.0",
    "history": "^5.3.0",
    "jsdom": "^26.1.0",
    "rslint-config-cozy-app": "^0.2.0",
    "rstack": "0.8.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint": "$eslint",
    "typescript": "$typescript",
    "js-yaml": "^4.3.2"
  }
}
