/* FullCalendar colours, from the twake-mui palette to follow the colour scheme */
.fc
  --fc-classic-background: var(--twake-palette-background-paper)
  --fc-classic-muted: var(--twake-palette-background-contrast)
  --fc-classic-muted-foreground: var(--twake-palette-text-secondary)
  --fc-classic-border: var(--twake-palette-divider)
  --fc-list-event-hover-bg-color: var(--twake-palette-action-hover)
  --fc-classic-now: var(--twake-palette-primary-main)

/* Custom main calendar view */
.fc-theme-standard td,
.fc-theme-standard th
  border 1px solid var(--twake-palette-divider)

th.fc-col-header-cell.fc-day
  border-left 0

a.fc-timegrid-axis-cushion
  color var(--twake-palette-text-primary)
  text-align center
  font-size 12.507px
  font-style normal
  font-weight 400
  line-height 18.76px
  letter-spacing 0.391px

/* Slot label visibility transitions */
.fc-timegrid-slot-label
  transition opacity 0.3s ease-in-out

.fc-daygrid-day-top small
  color var(--twake-palette-text-secondary)
  font-size 14px
  font-style normal
  font-weight 500
  line-height 20px
  letter-spacing 0.25px

.fc-daygrid-day-top .fc-daygrid-day-number,
span.fc-daygrid-day-number
  color var(--twake-palette-text-primary)
  font-size 28px
  font-style normal
  font-weight 400
  line-height 36px
  position relative
  width 48px
  line-height 39px

.fc-dayGridMonth-view .fc-daygrid-day-top .fc-daygrid-day-number
  display inline-block
  font-size 12px
  font-weight 500
  line-height 16px
  width auto
  min-width 16px
  text-align  center
  padding 0
  isolation isolate

.fc-dayGridMonth-view .fc-daygrid-day-top .fc-daygrid-day-number:after
  width 25px
  height 25px
  top 50%
  left 50%
  transform translate(-50%, -50%)

.fc-dayGridMonth-view .fc-day-other .fc-daygrid-day-number
  color var(--twake-palette-text-disabled)

.fc .calendar-month-grid
  border-top-width 0
  border-inline-width 0

.fc .calendar-month-grid .fc-col-header-cell
  border-inline-color transparent

.fc-dayGridMonth-view .compactStartTime
  display none

.fc-daygrid-day-top .fc-daygrid-day-number:after,
span.fc-daygrid-day-number:after
  content ""
  z-index -1
  border-radius 50%
  width 45px
  height 45px
  position absolute
  top 1px
  left 1px
  transition background-color 0.3s ease

span.fc-daygrid-day-number.current-date
  color var(--twake-palette-today-contrastText)

span.fc-daygrid-day-number.current-date:after
  background-color var(--twake-palette-today-main)

.fc-daygrid-day-top--mobile .fc-daygrid-day-number
  font-size 22px
  width 38px
  line-height 29px

.fc-daygrid-day-top--mobile .fc-daygrid-day-number:after
  width 36px
  height 36px

.fc-col-header-cell .fc-daygrid-day-top:not(.fc-daygrid-day-top--mobile)
  flex-direction row-reverse
  justify-content center

.fc-col-header-cell .fc-daygrid-day-number
  display grid
  place-items center
  height 47px

.fc-col-header-cell .fc-daygrid-day-top--mobile .fc-daygrid-day-number
  height 38px

.fc-col-header-cell .fc-daygrid-day-number:after
  top 50%
  left 50%
  transform translate(-50%, -50%)

.fc-timegrid-week-number
  width 80px
  margin-inline 0

.fc-timegrid-all-day-header
  min-height 34px

// Keep the sidebar and toolbar separators as the outer edges of the time grid.
.fc .calendar-time-grid
  border-top-width 0
  border-inline-width 0

.fc .calendar-time-grid .fc-col-header-cell
  border-inline-color transparent

// The all-day rules start at the first day column, beyond the time gutter.
.fc .calendar-time-grid-header-divider,
.fc .calendar-time-grid-all-day-divider
  display none

.fc .calendar-time-grid .fc-timegrid-body .fc-daygrid-day
  box-shadow inset 0 1px var(--twake-palette-divider), inset 0 -1px var(--twake-palette-divider)

td.fc-timegrid-slot.fc-timegrid-slot-label.fc-scrollgrid-shrink,
td.fc-timegrid-slot.fc-timegrid-slot-label.fc-timegrid-slot-minor
  border 0

th.fc-timegrid-axis.fc-scrollgrid-shrink
  border 0
  border-right 1px solid var(--twake-palette-divider)

.fc .fc-timegrid-axis-cushion
  min-width 80px
  max-width 80px
  margin-inline 0
  padding 0
  text-align left
  font-size 12.507px
  font-style normal
  font-weight 400
  line-height 18.76px
  padding 0 0 0 10px

.fc .fc-timegrid-divider
  display none
  height 0

.fc-timegrid-slot-label-cushion
  color unquote('rgba(var(--twake-palette-text-primaryChannel) / 0.48)')
  font-size 14px
  font-style normal
  font-weight 400
  line-height 20px
  letter-spacing 0.25px

th.fc-col-header-cell.fc-day
  border-right 0

.fc .fc-scrollgrid
  border 0

.fc .fc-timegrid-slot-label
  justify-content flex-end

.fc .fc-timegrid-slot-label .fc-timegrid-slot-label-frame
  position relative
  transform translate(-15px, -12px)

/* .fc tbody tr:first-of-type .fc-timegrid-slot-label .fc-timegrid-slot-label-frame
  display none */

.fc .fc-timegrid-slot-label .fc-timegrid-slot-label-frame::after
  content ""
  z-index -1
  background-color var(--twake-palette-divider)
  width 10px
  height 1px
  position absolute
  top 9.5px
  right -15px

// In v7 the timed day lanes sit above the horizontal slot lines.
.fc .fc-timegrid-col.fc-day-today
  --fc-classic-today: transparent

// Stack events above booking links and let clicks through the empty parts of the layer.
.fc .fc-timegrid-col
  z-index auto

.fc [aria-hidden='true']:has(> div > .calendar-time-lane)
  pointer-events none

.fc .calendar-time-events
  z-index 2
  pointer-events none

  > *
    pointer-events auto

.fc .fc-daygrid-day.fc-day-today
  background-color var(--twake-palette-background-paper)

.fc .fc-daygrid-body-natural .fc-daygrid-day-events
  margin-bottom 0

.fc .fc-timegrid-now-indicator-line
  z-index 5
  border 0 solid var(--twake-palette-primary-main)
  border-top-width 2px
  position absolute
  left 0
  right 0

.fc .fc-timegrid-now-indicator-line::after
  content ""
  z-index 5
  background-color var(--twake-palette-primary-main)
  border-radius 50%
  width 10px
  height 10px
  position absolute
  top -6px
  left -5px

.fc .fc-timegrid-now-indicator-arrow
  display block !important
  width auto
  height auto
  position relative
  border 0

.fc .fc-timegrid-now-indicator-arrow::before,
.now-time-label
  content attr(data-time)
  color var(--twake-palette-primary-main)
  white-space nowrap
  font-weight 600
  position absolute
  top -2px
  left 25px
  font-size 14px
  letter-spacing 0.25px

.timegrid-slot-label-hidden
  opacity 0.2

.fc-day-today .fc-timegrid-now-indicator-container
  overflow unset

.fc .fc-timegrid-slot
  min-height 20px

.fc .fc-timegrid-slot-label
  display flex
  align-items flex-start
  border-top-color transparent

tr:has(> td.fc-timegrid-divider.fc-cell-shaded)
  display none

.fc .fc-scrollgrid-section td
  border-bottom 0

.fc .fc-scrollgrid-section td .fc-daygrid-day-frame
  border-bottom 1px solid var(--twake-palette-divider)

.fc-dayGridMonth-view .fc-scrollgrid-section td .fc-daygrid-day-frame
    border-bottom none

.fc-col-header-cell.fc-day
  cursor pointer

.fc-col-header-cell.fc-day:hover .fc-daygrid-day-number:not(.current-date)::after
  background-color var(--twake-palette-action-focus)

/* Hover effects for month view using CSS */
.fc-daygrid-day:hover
  background-color var(--twake-palette-action-hover) !important
  transition background-color 0.3s ease

/* Hover effects for week and day views using JavaScript */
.hoverable-day-cell
  transition background-color 0.3s ease

.hour-highlight
  transition background-color 0.3s ease
  background-color var(--twake-palette-action-hover) !important
  position absolute
  left 0
  right 0
  pointer-events none
  z-index 1

.fc-timegrid-slot-label
  background-color var(--twake-palette-background-paper) !important

thead .fc-scroller,
tbody > tr.fc-scrollgrid-section:first-of-type .fc-scroller
  overflow hidden !important

.navigation-controls
  margin-right 16px

.fc .fc-timegrid-slot-minor
  border-top-style: none

/* FullCalendar "more" popover restyle */

.fc-more-popover
  z-index 700 !important
  border-radius 8px
  background var(--twake-palette-background-paper)
  overflow hidden
  width 244px
  box-shadow 0 4px 16px rgba(0,0,0,0.1)

  .fc-popover-header
    background var(--twake-palette-background-contrast)
    display flex
    justify-content space-between
    align-items center
    width 244px
    height 40px
    padding 12px
    border-bottom 1px solid var(--twake-palette-divider)

    .fc-popover-title
      font-weight 500
      font-size 14px
      color var(--twake-palette-text-primary)
      line-height 20px
      letter-spacing 0.1px

    .fc-popover-close
      color var(--twake-palette-text-icon)
      cursor pointer

  .fc-popover-body
    max-height 208px
    overflow auto
    padding 0 !important
    background var(--twake-palette-background-paper)

    .MuiCard-root
      box-shadow none !important
      border none !important
      border-radius 8px
      background-color transparent !important
      margin 2px 6px
      transition background 0.15s ease


      &:hover
        background var(--twake-palette-action-hover)

      .MuiCardHeader-root
        padding 4px 8px
        .MuiTypography-root
          white-space nowrap
          overflow hidden
          text-overflow ellipsis
          font-weight: 400 !important
          font-style: Regular !important
          font-size: 14px !important
          line-height: 20px !important
          letter-spacing: 0.25px !important
          vertical-align: middle !important
          color var(--twake-palette-text-primary) !important
          .compactStartTime
            display none

      .MuiCardContent-root
        padding 0 8px 4px 8px
        font-size 12px
        color var(--twake-palette-text-secondary)
        line-height 16px

    /* Hide FullCalendar’s extra margin block */
    .fc-more-popover-misc
      height 0 !important
      margin 0 !important
      padding 0 !important

// Custom event chips
.fc-event
  background-color transparent !important
  border none !important
  width 95%
  height 100%
  .fc-event-main
    display flex
    flex-direction row
    align-items center
    padding: 0

.fc-timegrid-event-harness-inset .fc-timegrid-event
  box-shadow none

/* Hide 00:00 time slot label */
.fc-timegrid-slot-label[data-time="00:00:00"] .fc-timegrid-slot-label-cushion,
.fc-timegrid-slot-label[data-time="00:00:00"] .fc-scrollgrid-shrink-cushion,
.fc-timegrid-slot-label[data-time="00:00:00"] .fc-timegrid-slot-label-frame::after
  opacity 0

.visually-hidden
  border 0
  clip rect(0 0 0 0)
  height 1px
  margin -1px
  overflow hidden
  padding 0
  position absolute
  width 1px
  whiteSpace nowrap
.date-time-group .MuiFormControl-root
  margin: 0
.date-time-group.show-full-field > .MuiBox-root:first-of-type
  margin-bottom: 8px

li.MuiButtonBase-root.MuiMenuItem-root
  padding 8px 16px
  font-size 14px

  &:hover
    background var(--twake-palette-action-hover)

hr.MuiDivider-root.MuiDivider-fullWidth
  margin 0

.calendar-swipe-container
  display grid
  grid-template-areas "main"
  height 100%
  overflow hidden
  touch-action pan-y

.calendar-swipe-container > div
  grid-area main
  width 100%
  height 100%

// Match all-day row height to a 30-minute slot
.fc-timeGridWeek-view .fc-daygrid-body .fc-daygrid-day-top,
.fc-timeGridDay-view .fc-daygrid-body .fc-daygrid-day-top
  display none

/* FullCalendar List View Custom Styling */
.fc .calendar-list-view .fc-list-event
  padding 0

.fc-listWeek-view.fc-list,
.fc-listMonth-view.fc-list
  border-width 0

.fc-list-table
  border-width 0
  border-collapse collapse
  display block

  tbody
    display block
    width 100%

.fc-list-day
  display none !important

.fc-list-event
  cursor pointer
  transition background-color 0.2s ease
  width 100%
  display block
  
  &:hover
    background-color var(--twake-palette-action-hover) !important

  td
    border none !important
    padding 0 !important
    vertical-align middle

.fc-list-day + .fc-list-event td
  border-top 1px solid var(--twake-palette-divider) !important

.fc-list-day:first-child + .fc-list-event td
  border-top none !important

.fc-list-event-time
  display none !important

.fc-list-event-graphic
  display none !important

.fc-list-event-title
  width 100% !important
  padding 0 !important
  display block

.hide-selection-highlight .fc-highlight
  display none !important

